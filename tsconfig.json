{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client",
      "node",
      "geojson"
    ],
    "noEmit": true,
    "paths": {
      "maplibre-gl-lanes": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "demo",
    "scripts",
    "test"
  ]
}